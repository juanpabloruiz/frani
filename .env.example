# Copiar este archivo como .env y reemplazar las contraseñas.

# Dominio (requerido para Cloudflare tunnel)
APP_DOMAIN=frani.ar
APP_PORT=8082

# App ID público de una aplicación propia en Meta for Developers (opcional).
# No usar el ID de la página ni el App Secret.
FACEBOOK_APP_ID=

# Publicación automática en una página propia de Facebook.
# Guardar solamente el token de Página, no el de Usuario. Nunca subirlo a Git.
FACEBOOK_AUTO_PUBLISH=false
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v26.0

# Base de datos
DB_HOST=frani-db
DB_PORT=3306
DB_NAME=frani
DB_USER=frani
DB_PASSWORD=cambiar-esta-clave
MYSQL_ROOT_PASSWORD=cambiar-esta-clave-root


# Zona horaria
TZ=America/Argentina/Cordoba

# TablePlus: conexión local a MySQL
MYSQL_PORT=3307

# phpMyAdmin local
PHPMYADMIN_PORT=8081
