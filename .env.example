# Copiar este archivo como .env y reemplazar las contraseñas.

# Dominio (requerido para Cloudflare tunnel)
APP_DOMAIN=frani.ar
APP_PORT=8082

# Base de datos
DB_HOST=db
DB_PORT=3306
DB_NAME=frani
DB_USER=frani
DB_PASSWORD=cambiar-esta-clave
MARIADB_ROOT_PASSWORD=cambiar-esta-clave-root

# phpMyAdmin
PHPMYADMIN_PORT=8081

# Zona horaria
TZ=America/Argentina/Cordoba
